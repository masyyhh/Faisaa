# ============================================================================
# FINORA — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to `server/.env` (or `.env` when using Docker Compose)
# ============================================================================

# 1. Runtime Environment ("development" | "production")
NODE_ENV="production"
PORT=5001

# 2. Database Connection
# Option A: Local / Single-Instance SQLite (WAL mode enabled automatically)
DATABASE_URL="file:./finora.db"
# Option B: Production PostgreSQL (Run `npm run db:postgres` before generating Prisma client)
# DATABASE_URL="postgresql://finora:your_strong_password@localhost:5432/finora?schema=public"

# 3. JWT Authentication (Generate with: openssl rand -hex 32)
JWT_SECRET="replace-with-a-cryptographically-secure-256-bit-secret-key"
JWT_EXPIRES_IN="7d"

# 4. Allowed Frontend Origins (comma-separated if hosting frontend separately)
CLIENT_URL="http://localhost:5001"

# 5. Demo Account Auto-Seeding ("true" | "false")
# Set to "false" in private production deployments to disable automatic demo user seeding
SEED_DEMO="false"

# 6. Optional Default Telegram Bot Credentials (Users can also set their own in Settings)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
