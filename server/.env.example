# ============================================================================
# FAISAA SERVER — ENVIRONMENT CONFIGURATION
# ============================================================================

NODE_ENV="production"
PORT=5001

# Database Connection (SQLite or PostgreSQL)
DATABASE_URL="file:./faisaa.db"
# POSTGRES_DATABASE_URL="postgresql://faisaa:your_strong_password@localhost:5432/faisaa?schema=public"

# Authentication & Encryption (Generate with: openssl rand -hex 32)
# Master key for sensitive credential encryption at rest (AES-256-GCM, strictly required, min 32 bytes or 64 hex characters)
ENCRYPTION_KEY="replace-with-a-cryptographically-secure-256-bit-encryption-key"
JWT_SECRET="replace-with-a-cryptographically-secure-256-bit-secret-key"
JWT_EXPIRES_IN="7d"

# Allowed Frontend Origin(s)
CLIENT_URL="http://localhost:5001"

# Demo Account Seeding ("true" | "false")
SEED_DEMO="false"

# Optional Telegram Bot Integration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
