# ============================================================================
# FINORA SERVER — ENVIRONMENT CONFIGURATION
# ============================================================================

NODE_ENV="production"
PORT=5001

# Database Connection (SQLite or PostgreSQL)
DATABASE_URL="file:./finora.db"
# DATABASE_URL="postgresql://finora:your_strong_password@localhost:5432/finora?schema=public"

# Authentication (Generate with: openssl rand -hex 32)
JWT_SECRET="replace-with-a-cryptographically-secure-256-bit-secret-key"
JWT_EXPIRES_IN="7d"

# Allowed Frontend Origin(s)
CLIENT_URL="http://localhost:5001"

# Demo Account Seeding ("true" | "false")
SEED_DEMO="false"

# Optional Telegram Bot Integration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
